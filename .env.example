# Copy to .env for local development. NEVER commit the real .env.

# --- YouTube Data API v3 (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# --- Warehouse
# Pipeline (write) connection. Leave empty to use the local SQLite fallback
# at data/trendpulse.db. For Supabase use the *Session pooler* URI, e.g.
# postgresql+psycopg://trendpulse_ingest.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Dashboard (read-only) connection. Use the trendpulse_reader role.
# Falls back to DATABASE_URL, then to local SQLite.
DASHBOARD_DATABASE_URL=

# --- Optional alerts
# Generic JSON webhook (Slack/Discord/Teams-compatible "text" payload)
TRENDPULSE_ALERT_WEBHOOK_URL=
# SMTP email alerts (all four required to enable)
TRENDPULSE_SMTP_HOST=
TRENDPULSE_SMTP_PORT=587
TRENDPULSE_SMTP_USER=
TRENDPULSE_SMTP_PASSWORD=
TRENDPULSE_ALERT_EMAIL_TO=

# --- Optional: show "Trigger ingestion" control in the dashboard.
# Requires a fine-grained GitHub token with Actions:write on this repo only,
# plus an operator passphrase. Leave empty to hide the control (recommended).
TRENDPULSE_GITHUB_DISPATCH_TOKEN=
TRENDPULSE_GITHUB_REPO=
TRENDPULSE_OPERATOR_PASSPHRASE=

# --- Overrides for config/pipeline.yaml use TRENDPULSE__SECTION__KEY
# TRENDPULSE__QUOTA__DAILY_BUDGET=9000
# TRENDPULSE__SCHEDULE__INTERVAL_MINUTES=30
